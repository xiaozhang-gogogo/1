# Netlify site environment variables.
# Netlify Blobs is auto-configured in Functions; you do not need a database URL.
TREEHOLE_BLOB_STORE=treehole

# Public site must require login.
REQUIRE_LOGIN=1
TZ=Asia/Shanghai
DEFAULT_TIME_ZONE=Asia/Shanghai

# Generate separate random values in Netlify before first public release.
ADMIN_TOKEN=CHANGE_ME_OWNER_TOKEN
ADMIN_MODERATOR_TOKEN=CHANGE_ME_MODERATOR_TOKEN
ADMIN_READONLY_TOKEN=CHANGE_ME_READONLY_TOKEN

# Moderation and media. Netlify Function request limits are smaller than the local server,
# so the bundled API caps image uploads at 4 MB unless IMAGE_MAX_BYTES is changed.
IMAGE_REVIEW=0
IMAGE_MAX_BYTES=4194304

# Optional. Set to 1 only after the public HTTPS domain is working.
ENABLE_HSTS=0
# PUBLIC_ORIGIN=https://your-domain.example
